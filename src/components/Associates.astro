---
import { getImage } from "astro:assets";

import bgMujeres from "../assets/projectsvision/mujeres.jpg";

import arandaneras3 from "../assets/carrusel/arandaneras3.jpg";
import equipo from "../assets/carrusel/equipo.jpg";
import insumos from "../assets/carrusel/insumos.jpg";
import mujeresferia from "../assets/carrusel/mujeresferia.jpg";
import arandaneros1 from "../assets/carrusel/arandaneros1.jpg";

const rawGallery = [
  { src: arandaneras3, alt: "Mujeres arandaneras" },
  { src: equipo, alt: "Equipo CFP" },
  { src: insumos, alt: "Entrega de insumos" },
  { src: mujeresferia, alt: "Mujeres en feria" },
  { src: arandaneros1, alt: "Productores arandaneros" },
];

const stats = [
  {
    number: 31,
    label:
      "Mujeres distribuidas en 18 Mujeres rurales, 3 Madres cabeza de familia entre otros",
  },
  {
    number: 7,
    label: "Discapacitados, desplazados y jóvenes rurales",
  },
  {
    number: 120,
    label:
      "Campesinos identificados en los 39 grupos familiares de los asociados",
  },
];

// Optimiza las fotografías para la web.
const background = await getImage({
  src: bgMujeres,
  width: 1600,
  format: "webp",
});

const galleryImages = await Promise.all(
  rawGallery.map(async (item) => ({
    ...item,
    image: await getImage({
      src: item.src,
      width: 520,
      format: "webp",
    }),
  })),
);
---

<section
  id="poblacion"
  class="associates-section"
  aria-labelledby="associates-title"
  style={`--associates-bg: url("${background.src}");`}
>
  <div class="associates-background" aria-hidden="true">
    <div class="associates-background-image"></div>
    <div class="associates-background-overlay"></div>
  </div>

  <div class="container associates-container">
    <header class="associates-header">
      <div class="associates-topline">
        <span class="associates-eyebrow">
          <span class="eyebrow-line"></span>
          03 / NUESTRA COMUNIDAD
        </span>

        <span class="associates-location">SILVANIA · CUNDINAMARCA</span>
      </div>

      <h2 id="associates-title" class="associates-title">
        EL CORAZÓN DE
        <span>NUESTRA TIERRA.</span>
      </h2>

      <p class="associates-introduction">
        Personas, familias e historias que hacen posible nuestra asociación
        campesina.
      </p>
    </header>

    <div class="associates-gallery">
      <div class="gallery-heading">
        <span>RETRATOS DE NUESTRA COMUNIDAD</span>
      </div>

      <div
        class="carousel-viewport"
        aria-label="Galería fotográfica de la asociación"
      >
        <div class="carousel-track" data-associates-track>
          <div class="carousel-group" data-carousel-group>
            {galleryImages.map((item, index) => (
              <figure class="carousel-card">
                <img
                  src={item.image.src}
                  width={item.image.attributes.width}
                  height={item.image.attributes.height}
                  alt={item.alt}
                  loading="lazy"
                  decoding="async"
                />

                <figcaption class="carousel-caption">
                  <span>{String(index + 1).padStart(2, "0")}</span>

                  <span>{item.alt}</span>
                </figcaption>
              </figure>
            ))}
          </div>

          <div class="carousel-group" aria-hidden="true" inert>
            {galleryImages.map((item, index) => (
              <figure class="carousel-card">
                <img
                  src={item.image.src}
                  width={item.image.attributes.width}
                  height={item.image.attributes.height}
                  alt=""
                  loading="lazy"
                  decoding="async"
                />

                <figcaption class="carousel-caption">
                  <span>{String(index + 1).padStart(2, "0")}</span>

                  <span>{item.alt}</span>
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      </div>

      <div class="gallery-footer">
        <span>IMÁGENES DE NUESTRA ASOCIACIÓN</span>

        <button
          type="button"
          class="carousel-toggle"
          data-carousel-toggle
          aria-label="Pausar carrusel"
          aria-pressed="false"
        >
          <span data-carousel-toggle-label>Pausar</span>
          <span aria-hidden="true" data-carousel-toggle-icon>
            Ⅱ
          </span>
        </button>
      </div>
    </div>

    <div class="associates-stats">
      <div class="stats-heading">
        <span>LA COMUNIDAD EN CIFRAS</span>
        <p>
          Detrás de cada cifra hay personas que trabajan por el desarrollo de
          nuestro territorio.
        </p>
      </div>

      <div class="stats-grid">
        {stats.map((stat, index) => (
          <article class="stat-card">
            <span class="stat-index">{String(index + 1).padStart(2, "0")}</span>

            <strong class="stat-number" data-target={stat.number}>
              {stat.number}
            </strong>

            <p class="stat-description">{stat.label}</p>
          </article>
        ))}
      </div>
    </div>

    <footer class="associates-footer">
      <span>CAMPESINOS FORJADORES DE PAZ</span>
      <span>PERSONAS QUE CULTIVAN FUTURO</span>
    </footer>
  </div>
</section>

<style>
  .associates-section {
    position: relative;
    isolation: isolate;
    width: 100%;
    padding: clamp(90px, 10vw, 150px) 0 40px;
    overflow: hidden;
    background: #0d2419;
    color: #ffffff;
    scroll-margin-top: 90px;
  }

  .associates-background {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  .associates-background-image {
    position: absolute;
    inset: -8% 0;
    background-image: var(--associates-bg);
    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;
    will-change: transform;
  }

  .associates-background-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(13, 36, 25, 0.94) 0%,
      rgba(13, 36, 25, 0.88) 45%,
      rgba(13, 36, 25, 0.98) 100%
    );
  }

  .associates-container {
    width: min(100% - 48px, 1320px);
    margin-inline: auto;
  }

  /* Encabezado */
  .associates-header {
    margin-bottom: clamp(50px, 7vw, 90px);
  }

  .associates-topline {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    margin-bottom: 35px;
  }

  .associates-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    color: #b7ed64;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
  }

  .eyebrow-line {
    width: 36px;
    height: 1px;
    background: currentColor;
  }

  .associates-location {
    color: rgba(255, 255, 255, 0.5);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
  }

  .associates-title {
    max-width: 1150px;
    margin: 0 0 30px;
    font-family: var(--font-display, Impact, sans-serif);
    font-size: clamp(3.4rem, 9.5vw, 9.5rem);
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .associates-title span {
    display: block;
    color: #b7ed64;
  }

  .associates-introduction {
    max-width: 580px;
    margin: 0;
    color: rgba(255, 255, 255, 0.75);
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    line-height: 1.7;
  }

  /* Galería */
  .associates-gallery {
    margin-bottom: clamp(70px, 10vw, 130px);
  }

  .gallery-heading,
  .gallery-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
  }

  .gallery-heading {
    margin-bottom: 20px;
  }

  .gallery-heading span,
  .gallery-footer > span {
    color: rgba(255, 255, 255, 0.6);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .gallery-heading span:last-child {
    color: #b7ed64;
  }

  .carousel-viewport {
    width: 100%;
    overflow: hidden;
    border-radius: 16px;
    padding: 18px 0;
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .carousel-track {
    display: flex;
    width: max-content;
    will-change: transform;
  }

  .carousel-group {
    display: flex;
    flex: 0 0 auto;
    gap: 18px;
    padding-right: 18px;
  }

  .carousel-card {
    position: relative;
    flex: 0 0 auto;
    width: clamp(180px, 21vw, 270px);
    height: clamp(250px, 30vw, 350px);
    margin: 0;
    overflow: hidden;
    border-radius: 12px;
    background: #173d27;
    isolation: isolate;
  }

  .carousel-card img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.04);
    will-change: transform;
  }

  .carousel-caption {
    position: absolute;
    inset: auto 0 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 50px 18px 18px;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.8), transparent);
  }

  .carousel-caption span:first-child {
    color: #b7ed64;
    font-size: 11px;
    font-weight: 700;
  }

  .carousel-caption span:last-child {
    color: #ffffff;
    font-size: 14px;
    font-weight: 700;
  }

  .gallery-footer {
    margin-top: 15px;
  }

  .carousel-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-height: 40px;
    padding: 8px 16px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 100px;
    background: transparent;
    color: #ffffff;
    font: inherit;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    transition:
      background 0.25s ease,
      color 0.25s ease;
  }

  .carousel-toggle:hover {
    background: #b7ed64;
    color: #102719;
  }

  .carousel-toggle:focus-visible {
    outline: 2px solid #b7ed64;
    outline-offset: 3px;
  }

  /* Estadísticas */
  .stats-heading {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 35px;
    margin-bottom: 30px;
  }

  .stats-heading > span {
    flex-shrink: 0;
    color: #b7ed64;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.15em;
  }

  .stats-heading p {
    max-width: 480px;
    margin: 0;
    color: rgba(255, 255, 255, 0.65);
    font-size: 15px;
    line-height: 1.7;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .stat-card {
    position: relative;
    min-width: 0;
    min-height: 260px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: clamp(24px, 3vw, 38px);
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.045);
    backdrop-filter: blur(8px);
  }

  .stat-card {
    overflow: hidden;
    isolation: isolate;
  }

  .stat-card::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;

    background: radial-gradient(
      280px circle at var(--light-x, 50%) var(--light-y, 50%),
      rgba(183, 237, 100, 0.14),
      transparent 75%
    );

    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease;
  }

  .stat-index {
    margin-bottom: 35px;
    color: rgba(255, 255, 255, 0.4);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .stat-number {
    display: block;
    margin-bottom: 20px;
    color: #b7ed64;
    font-family: var(--font-display, Impact, sans-serif);
    font-size: clamp(4.5rem, 7vw, 7.5rem);
    font-weight: 400;
    line-height: 0.85;
    font-variant-numeric: tabular-nums;
  }

  .stat-description {
    max-width: 350px;
    margin: auto 0 0;
    color: rgba(255, 255, 255, 0.8);
    font-size: clamp(0.85rem, 1.2vw, 1rem);
    line-height: 1.6;
  }

  /* Pie */
  .associates-footer {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-top: 65px;
    padding-top: 25px;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    color: rgba(255, 255, 255, 0.4);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.12em;
  }

  @media (hover: hover) and (pointer: fine) {
    .stat-card:hover::before {
      opacity: 1;
    }
  }

  /* Tabletas */
  @media (max-width: 950px) {
    .stats-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .stat-card:last-child {
      grid-column: 1 / -1;
    }
  }

  /* Móviles */
  @media (max-width: 600px) {
    .associates-section {
      padding: 90px 0 30px;
    }

    .associates-container {
      width: min(100% - 32px, 1320px);
    }

    .associates-location {
      display: none;
    }

    .associates-title {
      font-size: clamp(3rem, 13vw, 5rem);
    }

    .gallery-heading span,
    .gallery-footer > span {
      font-size: 9px;
    }

    .carousel-card {
      width: 180px;
      height: 250px;
    }

    .carousel-group {
      gap: 12px;
      padding-right: 12px;
    }

    .stats-heading {
      flex-direction: column;
      gap: 15px;
    }

    .stats-grid {
      grid-template-columns: 1fr;
    }

    .stat-card,
    .stat-card:last-child {
      grid-column: auto;
      min-height: 220px;
    }

    .stat-index {
      margin-bottom: 25px;
    }

    .associates-footer {
      flex-direction: column;
      gap: 10px;
      margin-top: 45px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel-track {
      will-change: auto;
    }

    .carousel-card img,
    .carousel-toggle {
      transition: none;
    }
    .associates-background-image {
      will-change: auto;
    }

    .carousel-card img {
      transform: none;
      will-change: auto;
    }

    .stat-card::before {
      display: none;
    }
  }
  @media (hover: none), (pointer: coarse) {
    .carousel-card img {
      transform: none;
      will-change: auto;
    }
  }
</style>

<script>
  import {
    initAssociates,
    destroyAssociates,
  } from "../js/components/associates.js";

  import {
    initAssociatesEffects,
    destroyAssociatesEffects,
  } from "../js/components/associatesEffects.js";

  // Inicializa el carrusel y las interacciones adicionales.
  function initAssociatesSection() {
    initAssociates();
    initAssociatesEffects();
  }

  // Limpia los recursos antes de cambiar de página.
  function destroyAssociatesSection() {
    destroyAssociatesEffects();
    destroyAssociates();
  }

  initAssociatesSection();

  document.addEventListener("astro:page-load", initAssociatesSection);

  document.addEventListener("astro:before-swap", destroyAssociatesSection);
</script>
